# Copy to .env and fill in your own values. Never commit .env.

# LLM API keys (at least one is required)
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
CLAUDE_API_KEY=<YOUR_CLAUDE_API_KEY>
# Optional: used by the Claude Code CLI backend if set
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Optional limits for the Claude bug fixer
CLAUDE_MAX_TURNS=5
CLAUDE_MAX_COST=0.10
CLAUDE_MAX_TOKENS=50000

# Optional web agent timeout in seconds
WEB_AGENT_TIMEOUT=90

# Tests and analysis scripts: location of input data and outputs
TEST_DATA_DIR=test_data
TEST_OUTPUTS_DIR=test_outputs
